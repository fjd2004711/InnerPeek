{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][A-Za-z0-9]*$"
      },
      "name": {
        "type": "object",
        "required": [
          "en"
        ],
        "properties": {
          "en": {
            "type": "string",
            "minLength": 1
          }
        },
        "patternProperties": {
          "^[a-z]{2,3}(-[A-Za-z0-9]+)*$": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  }
}

{
  "risks": [
    {
      "id": "env-file",
      "entryKind": "file",
      "names": [".env", ".env.*"],
      "excludeNames": [".env.example", ".env.sample", ".env.template", ".env.dist", ".env.defaults", ".env.schema", ".env.*.example", ".env.*.sample", ".env.*.template"],
      "scope": "repository",
      "respectsGitignore": true,
      "severity": "warning",
      "priority": 900,
      "title": {"en": "Environment file may expose secrets", "zh-Hans": "环境变量文件可能泄露密钥"},
      "detail": {"en": "%@ is not covered by .gitignore and may be committed.", "zh-Hans": "%@ 没有被 .gitignore 忽略，可能被提交。"},
      "archiveDetail": {"en": "%@ is included in this archive.", "zh-Hans": "此压缩包包含 %@。"}
    },
    {
      "id": "private-key",
      "entryKind": "file",
      "names": ["id_rsa", "id_dsa", "id_ecdsa", "id_ed25519", "*.pem", "*.key"],
      "excludePathComponents": ["test", "tests", "__tests__", "spec", "fixtures", "fixture", "testdata", "example", "examples", "sample", "samples"],
      "contentPattern": "-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----",
      "trustedWithoutContent": ["id_rsa", "id_dsa", "id_ecdsa", "id_ed25519"],
      "scope": "any",
      "respectsGitignore": true,
      "severity": "warning",
      "priority": 920,
      "title": {"en": "Private key file found", "zh-Hans": "发现私钥文件"},
      "detail": {"en": "%@ contains private key material. Keep it out of shared folders and repositories.", "zh-Hans": "%@ 含有私钥内容，请不要放进共享文件夹或代码仓库。"},
      "archiveDetail": {"en": "%@ is included in this archive and may be a private key.", "zh-Hans": "此压缩包包含 %@，可能是私钥。"}
    },
    {
      "id": "npm-auth-token",
      "entryKind": "file",
      "names": [".npmrc"],
      "contentPattern": "_authToken\\s*=\\s*[^\\s$]",
      "scope": "any",
      "respectsGitignore": true,
      "severity": "warning",
      "priority": 910,
      "title": {"en": "npm credentials found", "zh-Hans": "发现 npm 凭据"},
      "detail": {"en": "%@ contains an authentication token.", "zh-Hans": "%@ 中含有认证令牌。"}
    },
    {
      "id": "key-container",
      "entryKind": "file",
      "names": ["*.p12", "*.pfx", "*.jks", "*.keystore", "*.ppk"],
      "excludePathComponents": ["test", "tests", "__tests__", "spec", "fixtures", "fixture", "testdata", "example", "examples", "sample", "samples"],
      "scope": "repository",
      "respectsGitignore": true,
      "severity": "warning",
      "priority": 890,
      "title": {"en": "Key or certificate container found", "zh-Hans": "发现密钥或证书容器"},
      "detail": {"en": "%@ usually holds a private key and is not covered by .gitignore.", "zh-Hans": "%@ 通常包含私钥，且没有被 .gitignore 忽略。"},
      "archiveDetail": {"en": "%@ usually holds a private key and is included in this archive.", "zh-Hans": "%@ 通常包含私钥，且包含在此压缩包中。"}
    },
    {
      "id": "credential-file",
